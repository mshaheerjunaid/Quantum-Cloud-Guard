# Copy to .env and fill in. Generate the master key with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QCG_ENVIRONMENT=production
QCG_MASTER_KEY=
# Optional: auto-create the first admin on first run.
QCG_ADMIN_USER=admin
QCG_ADMIN_PASSWORD=
# Backend: auto (prefer liboqs, fall back to kyber_py) | liboqs | kyber_py
QCG_KEM_BACKEND=auto
# Bind. Behind the gateway use 0.0.0.0 inside the container (not host-published).
QCG_HOST=127.0.0.1
QCG_PORT=8800

# --- defense-in-depth hardening ---
# Host allow-list (comma-separated). "*" trusts any Host. Set to your gateway/
# domain in production, e.g. kms.internal,localhost
QCG_ALLOWED_HOSTS=*
# Max single encrypt payload in bytes (default 1 MiB).
QCG_MAX_PLAINTEXT_BYTES=1048576
# Per-IP failed-login throttle.
QCG_LOGIN_MAX_ATTEMPTS=10
QCG_LOGIN_WINDOW_SECONDS=60
# Interactive API docs: blank = on in dev, off in production. Set true/false to force.
# QCG_ENABLE_DOCS=

# --- time-scoped checkout / accountability (v1.2.0) ---
# Role -> checkout window (seconds), as JSON.
# QCG_CHECKOUT_TTLS={"technician":900,"engineer":3600,"manager":7200,"admin":28800}
# Fallback window for an unlisted role.
# QCG_CHECKOUT_DEFAULT_TTL=1800
# Only one open checkout per key at a time.
# QCG_CHECKOUT_EXCLUSIVE=false
# How often the background job scans for expired checkouts (seconds).
# QCG_CHECKOUT_CHECK_INTERVAL=30
# Where to POST an escalation when a checkout expires without check-in.
# QCG_ESCALATION_WEBHOOK_URL=https://hooks.example.com/qcg-escalation

# Force every non-admin decryption through the leased /api/checkout path
# (time-bounded + escalation-tracked). Admins keep direct unwrap for break-glass.
# QCG_REQUIRE_CHECKOUT=false
