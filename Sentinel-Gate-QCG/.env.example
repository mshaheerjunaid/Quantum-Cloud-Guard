# Sentinel-Gate configuration. Copy to `.env` and edit.
# Every variable is prefixed SENTINEL_ and maps to a field in config.py.
# The app validates these on boot and REFUSES TO START on an unsafe config.

# ----- Service ---------------------------------------------------------------
SENTINEL_ENVIRONMENT=development            # development | production | staging
SENTINEL_LOG_FORMAT=json                    # json | console
SENTINEL_LOG_LEVEL=INFO

# ----- Redis -----------------------------------------------------------------
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_REDIS_SOCKET_TIMEOUT=0.25
SENTINEL_REDIS_CONNECT_TIMEOUT=0.5

# ----- Client-IP resolution (anti IP-rotation) -------------------------------
# CIDRs of reverse proxies / load balancers you trust to set X-Forwarded-For.
# LEAVE EMPTY if clients connect directly: a spoofed header is then ignored.
# Example for a single LB: SENTINEL_TRUSTED_PROXIES=["10.0.0.0/8"]
SENTINEL_TRUSTED_PROXIES=[]
SENTINEL_FORWARDED_HEADER=x-forwarded-for
SENTINEL_TRUSTED_PROXY_HOPS=1

# ----- Rate limiting (token bucket) ------------------------------------------
SENTINEL_ANON_REFILL_PER_SEC=0.5
SENTINEL_ANON_BURST=10
SENTINEL_VIP_REFILL_PER_SEC=5
SENTINEL_VIP_BURST=100
SENTINEL_DEFAULT_ROUTE_COST=1.0
# Per-route weights (expensive endpoints cost more tokens):
# SENTINEL_ROUTE_COSTS={"/search": 5.0, "/data": 2.0, "/": 1.0}

# ----- Bans (escalating) -----------------------------------------------------
SENTINEL_BASE_BAN_SECONDS=30
SENTINEL_MAX_BAN_SECONDS=3600
SENTINEL_BAN_ESCALATION_FACTOR=2.0
SENTINEL_STRIKE_WINDOW_SECONDS=3600

# ----- Global circuit breaker ("under attack" mode) --------------------------
SENTINEL_GLOBAL_REFILL_PER_SEC=2000
SENTINEL_GLOBAL_BURST=20000
SENTINEL_UNDER_ATTACK_LIMIT_MULTIPLIER=0.25

# ----- Proof-of-work challenge -----------------------------------------------
SENTINEL_CHALLENGE_ENABLED=true
SENTINEL_CHALLENGE_DIFFICULTY_BITS=16       # each +1 doubles attacker work
SENTINEL_CHALLENGE_DIFFICULTY_BUMP=4        # extra bits while under attack
SENTINEL_CHALLENGE_PASS_TTL_SECONDS=900

# ----- Anomaly detection -----------------------------------------------------
SENTINEL_ANOMALY_ENABLED=true
SENTINEL_ANOMALY_CHALLENGE_THRESHOLD=0.6
SENTINEL_ANOMALY_THROTTLE_THRESHOLD=0.8
# Optional offline-trained IsolationForest (see tools/train_anomaly_model.py):
# SENTINEL_ANOMALY_MODEL_PATH=model.joblib

# ----- Telemetry / geo enrichment --------------------------------------------
# When enabled, each logged event is tagged with the client's approximate
# country, region, city, latitude, and longitude. Always done off the request
# hot path. Off by default (it depends on a data source and is a privacy
# consideration — IP geolocation is approximate, city-level at best).
SENTINEL_GEO_ENABLED=false
# PREFERRED source: a local MaxMind GeoLite2-City database. No network call per
# lookup, so it keeps working under attack and never sends client IPs to a third
# party. Get a free GeoLite2-City.mmdb from a MaxMind account, install the extra
# (pip install ".[geo]"), and point to it here:
# SENTINEL_GEO_DATABASE_PATH=/data/GeoLite2-City.mmdb
# FALLBACK source (used only if no local database is set): an HTTP provider.
SENTINEL_GEO_PROVIDER_URL=https://ipapi.co/{ip}/json/
SENTINEL_GEO_CACHE_TTL_SECONDS=86400        # cache a result for a day
SENTINEL_GEO_MAX_LOOKUPS_PER_SEC=5          # rate cap on outbound HTTP lookups
# --- Where decision/access logs go ---
# By default every decision is written as structured JSON to STDOUT (standard
# output). In Docker, `docker compose logs gateway` shows them and the log
# driver persists/ships them. This is the recommended default.
#
# To ALSO write a rotated JSON file, set a path below. The directory is created
# if missing; the file is size-rotated so it can never fill the disk. If the
# path is not writable the gateway logs a warning and stays on stdout only.
# SENTINEL_ACCESS_LOG_FILE=/var/log/sentinel-gate-qcg/access.log
SENTINEL_ACCESS_LOG_MAX_BYTES=52428800     # rotate at 50 MiB
SENTINEL_ACCESS_LOG_BACKUP_COUNT=5         # keep 5 old files (max ~300 MiB total)

# ----- Request hardening -----------------------------------------------------
SENTINEL_MAX_BODY_BYTES=1048576
SENTINEL_MAX_HEADER_COUNT=100
SENTINEL_ENABLE_HSTS=true
SENTINEL_COOKIE_SECURE=true                  # pass-token cookie is HTTPS-only
SENTINEL_METRICS_REQUIRE_AUTH=false          # gate /metrics behind the admin token
SENTINEL_ENABLE_DEMO_ROUTES=true             # set false once the real KMS is wired in
# SENTINEL_TRUSTED_HOSTS=["gateway.example.com"]   # set in production (Host validation)

# ----- Fail policy -----------------------------------------------------------
SENTINEL_REDIS_FAIL_MODE=open               # open (availability) | closed (integrity)
SENTINEL_FALLBACK_BURST=20
SENTINEL_FALLBACK_REFILL_PER_SEC=1

# ----- Secrets (REQUIRED in production; never commit real values) ------------
SENTINEL_VIP_ENABLED=false
# To use the optional VIP tier, set the above to true AND set a strong key:
# SENTINEL_VIP_API_KEY=change-me-to-a-strong-random-value-min-32-chars
SENTINEL_HMAC_SECRET=change-me-to-a-strong-random-value-min-32-chars
SENTINEL_ADMIN_TOKEN=change-me-to-a-strong-random-value

# --- device authorization (mutual TLS, v1.1.0) ---
# SENTINEL_MTLS_ENABLED=false
# SENTINEL_MTLS_MODE=header            # header | native
# Header mode (upstream proxy verifies the cert; trust only via trusted_proxies):
# SENTINEL_MTLS_VERIFY_HEADER=x-client-verify
# SENTINEL_MTLS_SUCCESS_VALUE=SUCCESS
# SENTINEL_MTLS_CLIENT_DN_HEADER=x-client-dn
# Native mode (uvicorn terminates mTLS):
# SENTINEL_TLS_CERTFILE=server.crt
# SENTINEL_TLS_KEYFILE=server.key
# SENTINEL_TLS_CLIENT_CA=device-ca.crt
